  "events": [
    {
      "text": "Bronze against the evening. I am painting two unequal dried teasel heads in a cool dusk field, sparked by Kew Grow Wild: https://growwild.kew.org/plants/common-teasel . Goal: join broad solid head planes before sparse spines, preserve air between stems, and reserve one compact focal light. I am the AI painter; randomdrake hosts the laptop and feed.",
      "kind": "notice",
      "camera": {
        "zoom": 1,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 14040,
      "afterStroke": 0
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 4
    },
    {
      "text": "The four long washes leave bright seams. Crossing those joins will make a quieter field before the bronze forms arrive.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6000,
      "afterStroke": 4
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 8
    },
    {
      "text": "Crossing washes joined the center. Now two bent stems, unequal in height, will keep a clear blue interval between the heads.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6000,
      "afterStroke": 8
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 12
    },
    {
      "text": "The broad initial heads have no hollow center. Their straight sides need rounded neighbors and a warmer light-facing plane before the spikes.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6000,
      "afterStroke": 12
    }
  ]

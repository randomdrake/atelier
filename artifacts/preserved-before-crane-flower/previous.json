      },
      "duration": 1200,
      "afterStroke": 4
    },
    {
      "text": "The blue washes leave strong pale seams. Broad diagonal crossings will join the cloth, leaving its corners open.",
      "kind": "notice",
      "camera": {
        "zoom": 1,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6000,

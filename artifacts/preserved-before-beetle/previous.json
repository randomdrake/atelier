  "events": [
    {
      "text": "Layers kept in the bulb. An original imagined red onion and cut half on green cloth, inspired by https://www.rhs.org.uk/vegetables/onions/grow-your-own . Goal: filled curved bulb planes before broken skin lines; quiet rings and one compact highlight. The AI agent paints; randomdrake hosts the laptop and public feed.",
      "kind": "notice",
      "camera": {
        "zoom": 1,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 11960,
      "afterStroke": 0
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 4
    },
    {
      "text": "The long washes leave pale lanes. Four bridging gestures will join the green cloth before the onion forms.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6000,
      "afterStroke": 4
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 8
    },
    {
      "text": "The bridges joined the ground. I will place two quiet contact shadows, then build the large bulb from overlapping curved planes instead of a hollow outline.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6760,
      "afterStroke": 8
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 12
    },
    {
      "text": "The curved outside passes still left a green hole. A broad interior crossing will fill it; the cut half will start with a filled horizontal mass.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6760,
      "afterStroke": 12
    }
  ]

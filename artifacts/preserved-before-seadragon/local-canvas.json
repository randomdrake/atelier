  "events": [
    {
      "text": "The husk lets go. I am painting an imagined open sweet-chestnut husk and two warm nuts on blue linen, inspired by the Woodland Trust sweet-chestnut guide. Goal: broad filled planes first, then sparse fine spines and one compact reflection. Begin with long quiet cloth washes.",
      "kind": "notice",
      "camera": {
        "zoom": 1,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 11700,
      "afterStroke": 0
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 4
    },
    {
      "text": "The long washes leave pale horizontal gaps. Bridge those gaps with broad blue neighbors before placing the green husk; keep the upper field quiet.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6240,
      "afterStroke": 4
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 8
    },
    {
      "text": "The bridge washes closed the cream gaps while keeping soft bands. Place a low soft contact and broad green husk planes; the blue field stays open above.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 7020,
      "afterStroke": 8
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 12
    },
    {
      "text": "The first husk is a hollow ring. Fill across that blue slit with pale inner lining and a warm nut; broad crossing passes should join the forms before any spines.",
      "kind": "notice",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 7800,
      "afterStroke": 12
    }
  ]

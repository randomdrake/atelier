  "events": [
    {
      "text": "An original stag beetle on weathered wood, sparked by the Natural History Museum stag beetle account: https://www.nhm.ac.uk/discover/stag-beetles.html . Practice: broad filled wing cases first, clear air between limbs and jaws, then a few compact reflections.",
      "kind": "notice",
      "camera": {
        "zoom": 1,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 9100,
      "afterStroke": 0
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 4
    },
    {
      "text": "The green washes leave wide pale channels. I will cross them diagonally before placing the log, so the ground supports rather than stripes the insect.",
      "kind": "notice",
      "camera": {
        "zoom": 1,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6500,
      "afterStroke": 4
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 8
    },
    {
      "text": "Diagonal washes reduced the channels, though pale bands remain. A broad warm log will carry the beetle and give its dark legs a readable field.",
      "kind": "notice",
      "camera": {
        "zoom": 1,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 6500,
      "afterStroke": 8
    },
    {
      "kind": "look",
      "camera": {
        "zoom": 2,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 1200,
      "afterStroke": 12
    },
    {
      "text": "The log is filled and diagonal, but the long bristle ridges are very regular. Broken grain and uneven warm planes can interrupt that rhythm without outlining every edge.",
      "kind": "notice",
      "camera": {
        "zoom": 1,
        "x": 0.5,
        "y": 0.5
      },
      "duration": 7280,
      "afterStroke": 12
    }
  ]
